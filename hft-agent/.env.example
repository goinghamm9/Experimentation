# HFT Agent Environment Variables
# Copy to .env and fill in your credentials

# Robinhood (legacy robin_stocks mode)
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_CODE=

# Robinhood Agentic Trading (MCP mode — recommended)
# Complete OAuth in Robinhood app: Agentic Trading > Connect your agent
ROBINHOOD_OAUTH_TOKEN=
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Interactive Brokers
# (Uses TWS/Gateway connection - no API keys needed, just host/port)

# TimescaleDB
TIMESCALE_PASSWORD=your_secure_password

# Redis (if auth enabled)
REDIS_PASSWORD=

# Application
APP_MODE=paper
LOG_LEVEL=INFO
