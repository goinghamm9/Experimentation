# Copy to .env. Everything here is optional.

# Alpaca market data (free account). If set, prices come from Alpaca instead of Yahoo.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=sip

# Robinhood needs no keys here: Claude Code signs in through Robinhood's own OAuth
# when you add the MCP server (see README "Trading on Robinhood").
